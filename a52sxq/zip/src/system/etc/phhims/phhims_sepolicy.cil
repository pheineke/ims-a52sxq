; PhhIms VoLTE package: the IMS app publishes phhims.call.slot<N>; init mirrors it into
; vendor.calls.slot_id<N> for the Samsung audio HAL (phhims.rc).
; Android 17 runs privileged apps targeting SDK < 37 as priv_app_36 (plat_seapp_contexts),
; newer ones as priv_app: grant both, not the wider priv_app_all attribute.
(type phhims_prop)
(roletype object_r phhims_prop)
(typeattributeset property_type (phhims_prop))
(typeattributeset system_property_type (phhims_prop))
(allow priv_app phhims_prop (property_service (set)))
(allow priv_app phhims_prop (file (read getattr map open)))
(allow priv_app property_socket (sock_file (write)))
(allow priv_app init (unix_stream_socket (connectto)))
(allow priv_app_36 phhims_prop (property_service (set)))
(allow priv_app_36 phhims_prop (file (read getattr map open)))
(allow priv_app_36 property_socket (sock_file (write)))
(allow priv_app_36 init (unix_stream_socket (connectto)))
